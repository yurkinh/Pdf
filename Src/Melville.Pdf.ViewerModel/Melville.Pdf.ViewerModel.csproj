<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(MelvilleLibraryTfms)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Title>Melville.Pdf.ViewerModel</Title>
        <PackageDescription>UI-independent view models for PDF viewer controls: page selection, page rendering
        with cancellation, zoom and fit layout, and optional content (layers).</PackageDescription>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Melville.Pdf.Model\Melville.Pdf.Model.csproj" />
        <ProjectReference Include="..\Melville.Pdf.TextExtractor\Melville.Pdf.TextExtractor.csproj" />
    </ItemGroup>

</Project>
