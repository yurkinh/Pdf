<Project>
    <PropertyGroup>
        <Version>0.6.9-preview</Version>
        <!-- Packing this fork's libraries for Plugin.Maui.PDFViewer: -p:MelvilleVersion=0.6.9-maui.1 (its pack-nuget.sh), so
             they never collide with upstream's packages of the same version, which are net11.0 only. -->
        <Version Condition="'$(MelvilleVersion)' != ''">$(MelvilleVersion)</Version>
        <LangVersion>14</LangVersion>
        <Authors>John Melville, MS, MD</Authors>
        <Company>Melville Computing</Company>
        <Copyright>2026 John Melville, MS, MD</Copyright>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <RepositoryUrl>https://github.com/DrJohnMelville/Pdf</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <!-- Cross-platform libraries ship both runtimes; apps, tools and Windows projects keep their own TFM -->
        <MelvilleLibraryTfms>net10.0;net11.0</MelvilleLibraryTfms>
    </PropertyGroup>

    <!-- Runtime async needs .NET 11 runtime support; net10.0 keeps compiler-generated state machines.
         -p:MelvilleRuntimeAsync=false turns it off on net11.0 too (benchmarks, mobile runtime fallback). -->
    <PropertyGroup Condition="$(TargetFramework.StartsWith('net11.0')) And '$(MelvilleRuntimeAsync)' != 'false'">
		<Features>$(Features);runtime-async=on</Features>
		<WarningsAsErrors>$(WarningsAsErrors);CA1305</WarningsAsErrors>
    </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Melville.Pdf.DataModelTests"/>
		<InternalsVisibleTo Include="Melville.Pdf.WpfToolTests"/>
		<InternalsVisibleTo Include="Performance.Playground"/>
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
	</ItemGroup>

	<!-- -p:MelvilleSkipCopyPackage=true when packing elsewhere (pack-nuget.sh): the copy expects the default output path. -->
	<Target Name="CopyPackage" AfterTargets="Pack" Condition="'$(MelvilleSkipCopyPackage)' != 'true'">
		<Copy SourceFiles="$(OutputPath)..\$(PackageId).$(PackageVersion).nupkg"
		      DestinationFolder="$(SolutionDir)..\..\TempNuget\" />
	</Target>
</Project>
