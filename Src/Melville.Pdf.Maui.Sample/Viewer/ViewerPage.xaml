<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewer="clr-namespace:Melville.Pdf.Maui.Sample.Viewer"
             xmlns:pdf="clr-namespace:Melville.Pdf.Maui.Controls;assembly=Melville.Pdf.Maui"
             x:Class="Melville.Pdf.Maui.Sample.Viewer.ViewerPage"
             x:DataType="viewer:ViewerViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False">

    <!-- PasswordSource before Source: the viewer reads the password source as soon as the source changes. -->
    <pdf:PdfViewer AutomationId="Viewer.PdfViewer"
                   PasswordSource="{Binding PasswordSource}"
                   Source="{Binding Source}"
                   PageNumber="{Binding PageNumber}" />
</ContentPage>
