<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Melville.Pdf.Maui.Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:spike="clr-namespace:Melville.Pdf.Maui.Sample.Spike"
    xmlns:viewer="clr-namespace:Melville.Pdf.Maui.Sample.Viewer"
    Title="Melville.Pdf.Maui.Sample">

    <TabBar>
        <ShellContent
            Title="Viewer"
            ContentTemplate="{DataTemplate viewer:ViewerPage}"
            Route="ViewerPage" />
        <ShellContent
            Title="Checks"
            ContentTemplate="{DataTemplate spike:SpikePage}"
            Route="SpikePage" />
    </TabBar>

</Shell>
