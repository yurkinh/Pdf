<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Built from the external/Melville.Streams submodule by build-local-packages.sh -->
    <add key="local" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Melville.StreamInterfaces" />
      <package pattern="Melville.IntersectionTypes" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
